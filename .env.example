# Copy this file to .env and fill in ONE AI provider key. Your keys never leave your computer
# except to call that provider. Use a paid API key: Upwork's terms forbid letting an AI
# provider train on Upwork content, and free tiers (for example Gemini's) may use your data.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6

# WhatsApp job alerts (optional, coming soon): off until scheduled searches are confirmed with Upwork.
# ENABLE_JOB_ALERTS=false
# Free personal WhatsApp option: CallMeBot.
# Get your key at https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_PHONE=+15551234567
# CALLMEBOT_APIKEY=
# Or send alerts to your own n8n / Make / Twilio webhook (POST JSON {source, text}):
# ALERT_WEBHOOK_URL=

# Optional
# PORT=8787
# PLAYBOOK_FILE=playbook/proposal-playbook.md
# While developing with "npm run dev", send Upwork sign-in back to the Vite page:
# APP_URL=http://localhost:5173/?upwork=connected
